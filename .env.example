# Optional overrides for Sand3D Hybrid Multimodal RAG
# Copy to .env if you want to customize paths, device, or local Ollama settings.

# Device: auto | cuda | mps | cpu
# SAND3D_DEVICE=auto

# Embedding models
# SAND3D_TEXT_MODEL=BAAI/bge-m3
# SAND3D_VISION_MODEL=google/siglip2-so400m-patch14-384

# Local or remote Ollama server for standalone generation / UI fallback
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Optional offline mode after initial indexing
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1
